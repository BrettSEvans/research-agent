# ── Anthropic ────────────────────────────────────────────────────────────────
# Server-side Anthropic key.  Used when the user hasn't supplied their own
# BYOK key via the UI.  You can set this OR rely entirely on BYOK.
ANTHROPIC_API_KEY=sk-ant-...

# Inception Labs Mercury models (mercury-2, mercury-coder-small)
# Get a free key (10M tokens) at https://inceptionlabs.ai
# INCEPTION_API_KEY=your_inception_key_here

# ── HTTP Basic Auth gate ──────────────────────────────────────────────────────
# Leave both empty to run without authentication (local dev).
# Set both to enable a single shared login for private beta / demo.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-before-deploy

# ── Optional model defaults (CLI only — web UI sends model explicitly) ────────
# EXTRACTOR_MODEL=claude-haiku-4-5
# ANALYZER_MODEL=claude-sonnet-4-6

# ── Persistent data volume (Docker / Railway) ─────────────────────────────────
# Railway mounts a persistent disk at /data.  The docker-entrypoint.sh script
# symlinks uploads/, deck_contexts/, saved_extractions/, saved_reports/ there.
# DATA_ROOT=/data
