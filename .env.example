# ── Anthropic ────────────────────────────────────────────────────────────────
# Server-side Anthropic key.  Used when the user hasn't supplied their own
# BYOK key via the UI.  You can set this OR rely entirely on BYOK.
ANTHROPIC_API_KEY=sk-ant-...

# Inception Labs Mercury models (mercury-2, mercury-coder-small)
# Get a free key (10M tokens) at https://inceptionlabs.ai
# INCEPTION_API_KEY=your_inception_key_here

# ── Google SSO ───────────────────────────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Public URL of this deployment (no trailing slash).
# Used to build the OAuth callback URL.
BASE_URL=https://myapp.railway.app
# Secret for signing session cookies.  Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
# Optional: restrict sign-in to specific email domains (comma-separated).
# Leave empty to allow any Google account.
# ALLOWED_EMAIL_DOMAINS=acme.com,partner.io

# ── HTTP Basic Auth gate ──────────────────────────────────────────────────────
# Leave both empty to run without authentication (local dev).
# When Google SSO is configured this acts as an API-only fallback (curl/scripts).
# Set both to use Basic Auth as the sole gate (no Google SSO).
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-before-deploy

# ── Optional model defaults (CLI only — web UI sends model explicitly) ────────
# EXTRACTOR_MODEL=claude-haiku-4-5
# ANALYZER_MODEL=claude-sonnet-4-6

# ── Persistent data volume (Docker / Railway) ─────────────────────────────────
# Railway mounts a persistent disk at /data.  The docker-entrypoint.sh script
# symlinks uploads/, deck_contexts/, saved_extractions/, saved_reports/ there.
# DATA_ROOT=/data
